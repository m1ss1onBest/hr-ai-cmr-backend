PORT=5000

# DATABASE_URL=postgresql://hrcrm:password@localhost:5433/hrcrm_db
DATABASE_URL=postgresql://hrcrm:password@localhost:5432/hrcrm_db

# JWT Options
ACCESS_TOKEN_SECRET=access_secret
REFRESH_TOKEN_SECRET=refresh_secret
ACCESS_TOKEN_EXPIRATION=8h
REFRESH_TOKEN_EXPIRATION=2d
RESET_PASSWORD_EXPIRATION=5m

# SMTP
SMTP_FROM=
SMTP_USER=
SMTP_HOST=
SMTP_PASS=
SMTP_PORT=

# Email frontend url's
EMAIL_VERIFICATION_URL=
EMAIL_FORGOT_PASSWORD_URL=

GEMINI_API_KEY=
AI_MODEL="gemini-1.5-flash"

# File uploads
# Where resumes are stored when using local storage
UPLOAD_DIR=uploads
# 10MB default
RESUME_MAX_SIZE_BYTES=10485760
# FILE_STORAGE_DRIVER=local

# MinIO
MINIO_HOST=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false

MINIO_ACCESS_KEY=hrcrm
MINIO_SECRET_KEY=password

MINIO_BUCKET=resumes