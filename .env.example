PORT=5000

# DATABASE_URL=postgresql://hrcrm:password@localhost:5433/hrcrm_db
DATABASE_URL=postgresql://hrcrm:password@localhost:5432/hrcrm_db

# JWT Options
ACCESS_TOKEN_SECRET=access_secret
REFRESH_TOKEN_SECRET=refresh_secret
ACCESS_TOKEN_EXPIRATION=8h
REFRESH_TOKEN_EXPIRATION=2d
RESET_PASSWORD_EXPIRATION=5m

# SMTP
SMTP_FROM=
SMTP_USER=
SMTP_HOST=
SMTP_PASS=
SMTP_PORT=

# Some other services url's
EMAIL_VERIFICATION_URL=
EMAIL_FORGOT_PASSWORD_URL=

# AI
GEMINI_API_KEY=
AI_MODEL="gemini-1.5-flash"

# File uploads
# Where resumes are stored when using local storage
UPLOAD_DIR=uploads
# 10MB default
RESUME_MAX_SIZE_BYTES=10485760
# FILE_STORAGE_DRIVER=local

# Storage
STORAGE_HOST=localhost
STORAGE_PORT=9000
STORAGE_USE_SSL=false
STORAGE_BUCKET=resumes
# If MinIO used
MINIO_ROOT_USER=hrcrm
MINIO_ROOT_PASSWORD=password

# Redis
REDIS_HOST=valkey
REDIS_PORT=6379
REDIS_PASSWORD=password