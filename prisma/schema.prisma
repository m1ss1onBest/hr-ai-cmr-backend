generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String          @id @default(uuid())
  email           String          @unique @db.VarChar(255)
  password        String
  role            UserRole        @default(HR)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @default(now()) @updatedAt
  deletedAt       DateTime?
  name            String          @db.VarChar(255)
  statusHistories StatusHistory[]
  vacancies       Vacancy[]
  comments        Comment[]
}

model Candidate {
  id                   String                @id @default(uuid())
  name                 String                @db.VarChar(255)
  email                String                @unique @db.VarChar(255)
  phone                String?               @db.VarChar(50)
  linkedInUrl          String?               @db.VarChar(2048)
  comment              String?
  cvUrl                String?
  expectedSalary       String?               @db.VarChar(255)
  positionId           String
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @default(now()) @updatedAt
  deletedAt            DateTime?
  applications         Application[]
  Position             Position              @relation(fields: [positionId], references: [id])
  candidateCredentials CandidateCredential[]
  statusHistories      StatusHistory[]
  comments             Comment[]
}

model StatusHistory {
  id            String          @id @default(uuid())
  candidateId   String
  status        CandidateStatus
  changedById   String
  applicationId String?
  createdAt     DateTime
  application   Application?    @relation(fields: [applicationId], references: [id])
  candidate     Candidate       @relation(fields: [candidateId], references: [id])
  changedBy     User            @relation(fields: [changedById], references: [id])
}

model CandidateCredential {
  id          String      @id @default(uuid())
  candidateId String
  type        ContactType
  value       String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @default(now()) @updatedAt
  deletedAt   DateTime?
  candidate   Candidate   @relation(fields: [candidateId], references: [id])
}

model Vacancy {
  id           String        @id @default(uuid())
  createdById  String
  title        String        @db.VarChar(255)
  description  String
  salary       String?
  /// Array of candidate requirements
  requirements Json
  techStack    String[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @default(now()) @updatedAt
  deletedAt    DateTime?
  applications Application[]
  createdBy    User          @relation(fields: [createdById], references: [id])
}

model Application {
  id          String          @id @default(uuid())
  candidateId String
  vacancyId   String
  createdAt   DateTime        @default(now())
  candidate   Candidate       @relation(fields: [candidateId], references: [id])
  vacancy     Vacancy         @relation(fields: [vacancyId], references: [id])
  statuses    StatusHistory[]
}

model Position {
  id        String      @id
  name      String      @unique @db.VarChar(255)
  Candidate Candidate[]
}

model Comment {
  id          String    @id @default(uuid())
  candidateId String
  authorId    String
  text        String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt
  deletedAt   DateTime?

  candidate Candidate @relation(fields: [candidateId], references: [id])
  author    User      @relation(fields: [authorId], references: [id])

  @@index([candidateId])
  @@index([authorId])
}

enum UserRole {
  ADMIN
  HR
}

enum CandidateStatus {
  NEW
  SCREENING
  INTERVIEW
  TEST_TALK
  OFFER
  HIRED
  REJECTED
}

enum ContactType {
  PHONE
  EMAIL
  LINKEDIN
}
