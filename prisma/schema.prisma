generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                         String          @id @default(uuid())
  email                      String          @unique @db.VarChar(255)
  password                   String
  role                       UserRole        @default(HR)
  createdAt                  DateTime        @default(now())
  updatedAt                  DateTime        @default(now()) @updatedAt
  deletedAt                  DateTime?
  name                       String          @db.VarChar(255)
  emailVerificationToken     String?         @db.VarChar(64)
  emailVerificationExpiresAt DateTime?
  isEmailVerified            Boolean         @default(false)
  comments                   Comment[]
  statusHistories            StatusHistory[]
  vacancies                  Vacancy[]
}

model Candidate {
  id                          String                      @id @default(uuid())
  name                        String                      @db.VarChar(255)
  cvUrl                       String?
  expectedSalary              String?                     @db.VarChar(255)
  createdAt                   DateTime                    @default(now())
  updatedAt                   DateTime                    @default(now()) @updatedAt
  deletedAt                   DateTime?
  comment                     String?
  email                       String                      @unique @db.VarChar(255)
  linkedInUrl                 String?                     @db.VarChar(2048)
  phone                       String?                     @db.VarChar(50)
  positionId                  String
  applications                Application[]
  Position                    Position                    @relation(fields: [positionId], references: [id])
  candidateCredentials        CandidateCredential[]
  comments                    Comment[]
  matchCandidateWithVacancies MatchCandidateWithVacancy[]
  resumeAnalyses              ResumeAnalysis[]
  statusHistories             StatusHistory[]
}

model StatusHistory {
  id            String          @id @default(uuid())
  candidateId   String
  status        CandidateStatus
  changedById   String
  applicationId String?
  createdAt     DateTime
  application   Application?    @relation(fields: [applicationId], references: [id])
  candidate     Candidate       @relation(fields: [candidateId], references: [id])
  changedBy     User            @relation(fields: [changedById], references: [id])
}

model CandidateCredential {
  id          String      @id @default(uuid())
  candidateId String
  type        ContactType
  value       String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @default(now()) @updatedAt
  deletedAt   DateTime?
  candidate   Candidate   @relation(fields: [candidateId], references: [id])
}

model Vacancy {
  id                          String                      @id @default(uuid())
  createdById                 String
  title                       String                      @db.VarChar(255)
  description                 String
  createdAt                   DateTime                    @default(now())
  updatedAt                   DateTime                    @default(now()) @updatedAt
  deletedAt                   DateTime?
  techStack                   String[]
  experience                  String?                     @db.VarChar(255)
  location                    String?                     @db.VarChar(255)
  salaryRange                 String?                     @db.VarChar(255)
  status                      VacancyStatus               @default(OPEN)
  workMode                    String?                     @db.VarChar(255)
  department                  String?                     @db.VarChar(255)
  applications                Application[]
  matchCandidateWithVacancies MatchCandidateWithVacancy[]
  createdBy                   User                        @relation(fields: [createdById], references: [id])
}

model MatchCandidateWithVacancy {
  id              String              @id @default(uuid())
  candidateId     String
  vacancyId       String
  recommendation  MatchRecommendation
  matchPercentage Int
  strengths       Json
  gaps            Json
  analyzedAt      DateTime            @default(now())
  candidate       Candidate           @relation(fields: [candidateId], references: [id])
  vacancy         Vacancy             @relation(fields: [vacancyId], references: [id])

  @@unique([candidateId, vacancyId])
}

model Application {
  id          String          @id @default(uuid())
  candidateId String
  vacancyId   String
  createdAt   DateTime        @default(now())
  candidate   Candidate       @relation(fields: [candidateId], references: [id])
  vacancy     Vacancy         @relation(fields: [vacancyId], references: [id])
  statuses    StatusHistory[]
}

model Position {
  id        String      @id
  name      String      @unique @db.VarChar(255)
  Candidate Candidate[]
}

model ResumeAnalysis {
  id                String    @id @default(uuid())
  candidateId       String
  skills            Json
  level             String?   @db.VarChar(50)
  yearsOfExperience Int?
  technologies      Json
  softSkills        Json?
  score             Int
  summary           String
  analyzedAt        DateTime  @default(now())
  candidate         Candidate @relation(fields: [candidateId], references: [id])
}

model Comment {
  id          String    @id @default(uuid())
  candidateId String
  authorId    String
  text        String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt
  deletedAt   DateTime?
  author      User      @relation(fields: [authorId], references: [id])
  candidate   Candidate @relation(fields: [candidateId], references: [id])

  @@index([candidateId])
  @@index([authorId])
}

enum VacancyStatus {
  OPEN
  CLOSED
  PAUSED
}

enum MatchRecommendation {
  PROCEED
  REVIEW_MANUALLY
  REJECT
}

enum UserRole {
  ADMIN
  HR
}

enum CandidateStatus {
  NEW
  SCREENING
  INTERVIEW
  TEST_TALK
  OFFER
  HIRED
  REJECTED
}

enum ContactType {
  PHONE
  EMAIL
  LINKEDIN
}
